# ---------------------------------------------------------------------------
# Jarvis environment configuration
# Copy to `.env` next to the project (or export these in your shell).
# Every key here is optional: `jarvis config` writes a config file instead.
# ---------------------------------------------------------------------------

# --- Real (cloud) NVIDIA NIM -------------------------------------------------
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any NIM / build.nvidia.com model id. `auto` picks a sensible default.
NVIDIA_MODEL=auto

# --- Gemini ------------------------------------------------------------------
# Same key powers both plain chat and Live voice mode.
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=auto
GEMINI_LIVE_MODEL=auto

# --- Generic OpenAI-compatible endpoint (Ollama, OpenRouter, Groq, LM Studio) -
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# --- Runtime -----------------------------------------------------------------
# Default provider used when `--provider` is not given.
JARVIS_PROVIDER=nvidia_nim
# Spoken replies + wake word behaviour
JARVIS_VOICE=none
# Never auto-run these; comma separated tool names that need a confirmation.
JARVIS_DENY_TOOLS=
# Auto-confirm dangerous tool calls (rm -rf, etc). Leave false.
JARVIS_YOLO=false
JARVIS_LOG_LEVEL=info
